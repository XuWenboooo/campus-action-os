page {
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
}

.page {
  padding: 32rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx 0;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.button {
  background: #2563eb;
  border-radius: 14rpx;
  color: #ffffff;
  margin: 20rpx 0;
}

.button.secondary {
  background: #e2e8f0;
  color: #0f172a;
}

.danger {
  color: #b91c1c;
}

textarea,
input {
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin: 16rpx 0;
  padding: 20rpx;
  width: 100%;
}
