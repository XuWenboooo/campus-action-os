/* Campus Action OS · 学生端宿主全局样式 */
page {
  background: #f4f6fa;
  color: #0f172a;
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  line-height: 1.6;
}

.page {
  padding: 0 0 60rpx;
}

.hero {
  background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
  padding: 48rpx 40rpx 56rpx;
  color: #ffffff;
}

.hero-tag {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #bfdbfe;
  border: 1rpx solid rgba(191, 219, 254, 0.45);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #cbd5e1;
  line-height: 1.7;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(15, 23, 42, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.card-sub {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin: 28rpx 0 12rpx;
}

.muted {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  color: #334155;
}

.row-value {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #475569;
}

.row-value.ok {
  background: #dcfce7;
  color: #15803d;
}

.row-value.pending {
  background: #fef3c7;
  color: #b45309;
}

.row-value.off {
  background: #fee2e2;
  color: #b91c1c;
}

.btn {
  margin: 8rpx 0 0;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 12rpx;
  line-height: 2.6;
}

.btn::after {
  border: none;
}

.probe {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  word-break: break-all;
  background: #f1f5f9;
  color: #475569;
}

.probe.ok {
  background: #dcfce7;
  color: #15803d;
}

.probe.fail {
  background: #fee2e2;
  color: #b91c1c;
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx 22rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.node {
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.node-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.node-id {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.node-type {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #334155;
}

.type-action {
  background: #dbeafe;
  color: #1d4ed8;
}

.type-decision {
  background: #fef3c7;
  color: #b45309;
}

.type-notice_revision {
  background: #f3e8ff;
  color: #7e22ce;
}

.type-precondition {
  background: #ccfbf1;
  color: #0f766e;
}

.type-milestone {
  background: #dcfce7;
  color: #15803d;
}

.node-body {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

.edge {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.edge:last-child {
  border-bottom: none;
}

.edge-name {
  font-size: 24rpx;
  color: #334155;
}

.edge-type {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.foot {
  margin: 32rpx 24rpx 0;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.8;
  text-align: center;
}
