<view class="page">
  <view class="eyebrow">ACTION RESULT / 03</view>
  <view class="title">这条通知与你有关</view>
  <view class="result-sub"><status-badge label="高置信度" tone="green"></status-badge><text class="muted">已根据你的学生画像匹配</text></view>
  <view class="card relevance" wx:if="{{assessment}}"><view class="caption">PERSONAL RELEVANCE</view><view class="relevance-text">{{assessment.relevance_reason}}</view></view>
  <view class="card action-result-card" wx:if="{{action}}">
    <view class="row"><text class="tag blue">ACTION 01</text><text class="caption">待确认</text></view>
    <view class="action-title">{{action.title}}</view>
    <view class="deadline-label">DEADLINE</view><view class="deadline">{{action.deadline.display}}</view>
    <view class="field-grid">
      <view class="field"><view class="caption">WHERE</view><view class="field-value">{{action.platform}}</view></view>
      <view class="field"><view class="caption">NEED</view><view class="field-value">{{action.materials}}</view></view>
      <view class="field"><view class="caption">AUDIENCE</view><view class="field-value">{{action.audience}}</view></view>
      <view class="field"><view class="caption">CONDITION</view><view class="field-value">{{action.condition}}</view></view>
    </view>
    <view class="divider"></view>
    <view class="why-row" bindtap="openEvidence"><view><view class="why-title">为什么？</view><view class="muted">每个判断都有原文依据</view></view><text class="why-arrow">→</text></view>
  </view>
  <view class="section-title" wx:if="{{action && action.steps.length > 1}}">Action Graph <text class="caption">行动路径</text></view>
  <view class="graph" wx:if="{{action}}"><view class="graph-step" wx:for="{{action.steps}}" wx:key="*this"><view class="graph-number">0{{index + 1}}</view><view><view class="field-value">{{item}}</view><view class="caption">待完成</view></view></view></view>
  <view class="danger" wx:if="{{error}}">{{error}}</view>
  <view class="bottom-bar" wx:if="{{action}}"><button class="button" loading="{{creating}}" disabled="{{creating}}" bindtap="createTask">确认并创建任务</button><button class="button ghost" bindtap="reject">这不是我的任务</button></view>
</view>
