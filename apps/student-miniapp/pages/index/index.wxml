<view class="page">
  <view class="eyebrow">CAMPUS ACTION OS · 09 / 15</view>
  <view class="title">校园行动 OS</view>
  <view class="muted">今天，你只需要关注这些。</view>
  <view class="hero-stats">
    <view class="stat"><view class="stat-number">{{todayTasks.length}}</view><view class="caption">今天需要完成</view></view>
    <view class="stat"><view class="stat-number">{{upcomingTasks.length}}</view><view class="caption">未来 3 天</view></view>
    <view class="stat alert"><view class="stat-number">{{changedTasks.length}}</view><view class="caption">发生变化</view></view>
  </view>
  <orchestration-suggestion-card wx:if="{{orchestrationSuggestion}}" suggestion="{{orchestrationSuggestion}}" bind:open="openOrchestration"></orchestration-suggestion-card>
  <conflict-alert-card wx:if="{{conflictAlert}}" conflict="{{conflictAlert}}" bind:open="openConflict"></conflict-alert-card>
  <view class="section-title row"><view>Today <text class="caption">今天</text></view><text class="section-link" bindtap="openTasks">全部任务 →</text></view>
  <view class="card action-card" wx:for="{{todayTasks}}" wx:key="task_id" bindtap="openTask" data-id="{{item.task_id}}">
    <view class="row"><text class="tag orange">待完成</text><text class="caption">{{item.source}}</text></view>
    <view class="card-title">{{item.title}}</view>
    <view class="deadline">{{item.due_display}}</view>
    <view class="meta-row"><text>⌁ {{item.platform}}</text><text>查看行动 →</text></view>
  </view>
  <view class="empty card" wx:if="{{!todayTasks.length}}">今天没有待办，做得很好。</view>
  <view class="section-title">Upcoming <text class="caption">接下来</text></view>
  <view class="card compact-card" wx:for="{{upcomingTasks}}" wx:key="task_id" bindtap="openTask" data-id="{{item.task_id}}">
    <view class="row"><view class="card-title">{{item.title}}</view><text class="tag blue">{{item.due_display}}</text></view>
    <view class="source">{{item.platform}} · {{item.source}}</view>
  </view>
  <view class="section-title">Changed <text class="caption">有变化</text></view>
  <view class="card change-card" wx:for="{{changedTasks}}" wx:key="change_event_id" bindtap="openDiff" data-id="{{item.change_event_id}}">
    <view class="row"><text class="tag red">通知有更新</text><text class="caption">刚刚发现</text></view>
    <view class="card-title">{{item.task_title}}</view>
    <view class="change-label">{{item.change_label}}</view>
    <view class="diff-preview"><text class="strike">{{item.old_value}}</text><text class="arrow">→</text><text class="new-date">{{item.new_value}}</text></view>
    <view class="source">{{item.source}} · 查看变化 →</view>
  </view>
  <view class="section-title">Try a scenario <text class="caption">现场演示</text></view>
  <view class="demo-row">
    <view class="demo-chip" bindtap="openDemo" data-scenario="student"><text class="demo-icon">01</text><text>学籍核验</text></view>
    <view class="demo-chip" bindtap="openDemo" data-scenario="scholarship"><text class="demo-icon">02</text><text>奖学金</text></view>
    <view class="demo-chip" bindtap="openDemo" data-scenario="extension"><text class="demo-icon">03</text><text>延期通知</text></view>
    <view class="demo-chip" bindtap="openDemo" data-scenario="orchestration"><text class="demo-icon">04</text><text>行动编排</text></view>
  </view>
  <view class="danger" wx:if="{{error}}">{{error}}</view>
  <view class="bottom-bar"><button class="button" bindtap="openImport">＋ 导入通知</button></view>
</view>
