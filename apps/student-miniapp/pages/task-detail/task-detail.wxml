<view class="page">
  <view class="eyebrow">TASK / 05</view>
  <view wx:if="{{task}}">
    <view class="row status-row"><status-badge label="{{task.status === 'completed' ? '已完成' : task.status === 'changed' ? '待确认更新' : '待完成'}}" tone="{{task.status === 'completed' ? 'green' : task.status === 'changed' ? 'red' : 'orange'}}"></status-badge><text class="caption">{{task.source}}</text></view>
    <view class="title task-title">{{task.title}}</view>
    <view class="deadline-card"><view class="caption">DEADLINE</view><view class="deadline">{{task.due_display || task.due_at || '待确认'}}</view><view class="muted">请在截止时间前完成</view></view>
    <view class="section-title">行动</view>
    <view class="card"><view class="card-title">你需要做什么</view><view class="body-copy">{{actionSteps}}</view><view class="source">平台：{{task.platform}}</view></view>
    <view class="section-title">条件与证据</view>
    <view class="card"><view class="row"><text class="caption">CONDITION</text><text class="tag blue">已核验</text></view><view class="body-copy">{{action ? action.condition : '请根据原通知完成。'}}</view><view class="evidence-link" bindtap="openEvidence">查看原文依据 →</view></view>
    <view class="section-title">History</view>
    <view class="history card"><view><text class="history-dot"></text>任务创建</view><text class="caption">09-13 10:24</text><view><text class="history-dot"></text>最近更新</view><text class="caption">09-14 15:02</text></view>
  </view>
  <view class="danger" wx:if="{{error}}">{{error}}</view>
  <view class="bottom-bar" wx:if="{{task && task.status !== 'completed'}}"><button class="button" loading="{{completing}}" disabled="{{completing}}" bindtap="complete">标记完成</button></view>
</view>
