<view class="page">
  <view class="eyebrow">ALL ACTIONS</view>
  <view class="title">全部任务</view>
  <view class="muted">每个任务都来自一条可回溯的校园通知。</view>
  <view class="card" wx:for="{{tasks}}" wx:for-item="task" wx:for-index="index" wx:key="task_id">
    <view bindtap="openTask" data-id="{{task.task_id}}"><view class="row"><text class="tag {{task.status === 'completed' ? 'green' : task.status === 'changed' ? 'red' : 'orange'}}">{{task.status === 'completed' ? '已完成' : task.status === 'changed' ? '有更新' : '待完成'}}</text><text class="caption">{{task.source}}</text></view><view class="list-title">{{task.title}}</view><view class="deadline">{{task.due_display || task.due_at || '待确认'}}</view><view class="source">{{task.platform}} · 查看详情 →</view></view>
    <button wx:if="{{task.status === 'changed'}}" class="button secondary" bindtap="openDiff">查看通知变化</button>
    <button wx:if="{{task.status === 'pending' || task.status === 'in_progress'}}" class="button" loading="{{loadingTaskId === task.task_id}}" disabled="{{loadingTaskId === task.task_id}}" bindtap="completeTask" data-index="{{index}}">确认完成任务</button>
  </view>
  <view class="card" wx:if="{{!tasks.length}}">暂无任务。</view>
  <view class="danger" wx:if="{{error}}">{{error}}</view>
</view>
