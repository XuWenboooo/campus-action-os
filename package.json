{
  "name": "campus-action-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "test:built": "node scripts/test-built-protocol.mjs",
    "test:contracts": "node scripts/run-python-checks.mjs contracts",
    "test:benchmark": "node scripts/run-python-checks.mjs benchmark",
    "test:integration": "node scripts/run-python-checks.mjs integration",
    "python:syntax": "node scripts/run-python-checks.mjs syntax",
    "benchmark:audit": "node scripts/run-python-checks.mjs audit",
    "schema:check": "node scripts/run-python-checks.mjs integration",
    "test:python": "node scripts/run-python-checks.mjs all",
    "test:m2": "node --test --import tsx tests/contracts/m2-text-contract.test.ts tests/e2e/m2-text-harness.test.ts",
    "dev:mock": "tsx tools/integration/mock-ai-parser/server.ts",
    "release:m2-manifest:verify": "node scripts/m2-manifest.mjs",
    "release:manifest:verify": "node scripts/m1-manifest.mjs verify",
    "diff:check": "git diff --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:built && npm run scan:secrets && npm run test:python && npm run release:m2-manifest:verify && npm run release:manifest:verify && npm run diff:check",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:ai": "tsx services/ai-parser/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
