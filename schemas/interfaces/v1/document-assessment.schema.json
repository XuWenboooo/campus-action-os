{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/interfaces/v1/document-assessment.schema.json",
  "title": "Campus Action OS Document Assessment v1",
  "type": "object",
  "required": ["schema_version", "document_id", "user_relevance", "relevance_reason", "evidence", "verification_status"],
  "properties": {
    "schema_version": { "const": "document-assessment/v1" },
    "document_id": { "type": "string", "minLength": 1 },
    "user_relevance": { "enum": ["relevant", "irrelevant", "uncertain"] },
    "relevance_reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "verification_status": { "enum": ["passed", "conflict", "user_confirmation_required"] }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "source_text", "field_name"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_text": { "type": "string", "minLength": 1 },
        "field_name": { "enum": ["user_relevance", "target_population", "deadline", "conflict", "other"] },
        "span": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
      },
      "unevaluatedProperties": false
    }
  }
}
