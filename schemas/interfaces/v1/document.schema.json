{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/interfaces/v1/document.schema.json",
  "title": "Campus Action OS Document v1",
  "type": "object",
  "required": ["schema_version", "document_id", "owner_user_id", "title", "content_type", "text", "content_sha256", "data_origin", "created_at"],
  "properties": {
    "schema_version": { "const": "document/v1" },
    "document_id": { "type": "string", "minLength": 1 },
    "owner_user_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "content_type": { "enum": ["text/plain", "image/png", "application/pdf", "text/html"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "data_origin": { "enum": ["synthetic", "user_provided"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "unevaluatedProperties": false
}
