{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/interfaces/v1/notification-revision.schema.json",
  "title": "Campus Action OS Notification Revision v1",
  "type": "object",
  "required": ["schema_version", "notice_id", "revision_id", "revision_number", "status", "title", "body", "created_at", "published_at"],
  "properties": {
    "schema_version": { "const": "notification-revision/v1" },
    "notice_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "minLength": 1 },
    "revision_number": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published", "postponed", "revoked"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "body": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "created_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "unevaluatedProperties": false
}
