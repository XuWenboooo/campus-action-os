{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/interfaces/v1/parse-job.schema.json",
  "title": "Campus Action OS Parse Job v1",
  "type": "object",
  "required": ["schema_version", "parse_job_id", "document_id", "user_id", "request_id", "idempotency_key", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "parse-job/v1" },
    "parse_job_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["queued", "running", "succeeded", "partial", "needs_confirmation", "failed"] },
    "result": { "anyOf": [{ "$ref": "https://campus-action-os.example/schemas/interfaces/v1/text-parse-response.schema.json" }, { "type": "null" }] },
    "error": { "anyOf": [{ "$ref": "https://campus-action-os.example/schemas/interfaces/v1/error.schema.json#/$defs/error" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "unevaluatedProperties": false
}
