{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/interfaces/v1/task.schema.json",
  "title": "Campus Action OS Task v1",
  "type": "object",
  "required": ["schema_version", "task_id", "user_id", "action_id", "document_id", "title", "status", "due_at", "created_at", "updated_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "task/v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "action_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "status": { "enum": ["pending", "in_progress", "completed", "expired", "cancelled"] },
    "due_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "string", "format": "date" }, { "type": "null" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "unevaluatedProperties": false
}
