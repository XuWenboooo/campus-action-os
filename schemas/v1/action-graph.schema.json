{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/v1/action-graph.schema.json",
  "title": "Campus Action OS Action Graph v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "action-graph/v1" },
    "graph_id": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["node_id", "node_type"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "node_type": { "enum": ["action", "precondition", "decision", "milestone", "notice_revision"] },
        "action_id": { "type": "string", "minLength": 1 },
        "population_groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "condition_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "milestone_id": { "type": "string", "minLength": 1 },
        "notice_revision_id": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "node_type": { "const": "action" } } }, "then": { "required": ["action_id"] } },
        { "if": { "properties": { "node_type": { "const": "precondition" } } }, "then": { "required": ["condition_ids"] } },
        { "if": { "properties": { "node_type": { "const": "decision" } } }, "then": { "required": ["condition_ids"] } },
        { "if": { "properties": { "node_type": { "const": "milestone" } } }, "then": { "required": ["milestone_id"] } },
        { "if": { "properties": { "node_type": { "const": "notice_revision" } } }, "then": { "required": ["notice_revision_id"] } }
      ],
      "unevaluatedProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["edge_id", "from_node_id", "to_node_id", "edge_type"],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "from_node_id": { "type": "string", "minLength": 1 },
        "to_node_id": { "type": "string", "minLength": 1 },
        "edge_type": { "enum": ["blocks", "requires", "informs", "branches_to", "alternative_to", "postpones", "revokes", "replaces"] },
        "condition_id": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "edge_type": { "const": "branches_to" } } },
      "then": { "required": ["condition_id"] },
      "unevaluatedProperties": false
    }
  }
}
