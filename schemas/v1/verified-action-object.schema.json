{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/v1/verified-action-object.schema.json",
  "title": "Campus Action OS Verified Action Object v1",
  "type": "object",
  "required": [
    "schema_version", "action_id", "document_id", "title", "target_population",
    "user_relevance", "relevance_reason", "action_type", "steps", "dependencies",
    "conditions", "exceptions", "deadline", "location", "platform", "entry_link",
    "required_materials", "consequence", "obligation", "evidence", "confidence",
    "epistemic_status", "field_status", "result_stage", "verification_status",
    "task_status", "change_history"
  ],
  "properties": {
    "schema_version": { "const": "verified-action-object/v1" },
    "action_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "document_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "target_population": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "user_relevance": { "enum": ["relevant", "irrelevant", "uncertain"] },
    "relevance_reason": { "type": "string", "minLength": 1 },
    "action_type": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } },
    "deadline": { "$ref": "#/$defs/deadline" },
    "location": { "anyOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
    "platform": { "anyOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
    "entry_link": { "anyOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
    "required_materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "consequence": { "anyOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
    "obligation": { "enum": ["mandatory", "recommended", "informational", "unknown"] },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "confidence": { "$ref": "#/$defs/confidence" },
    "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
    "field_status": { "$ref": "#/$defs/fieldStatus" },
    "result_stage": { "$ref": "#/$defs/resultStage" },
    "verification_status": { "enum": ["passed", "conflict", "user_confirmation_required"] },
    "task_status": { "enum": ["pending", "in_progress", "completed", "expired", "cancelled"] },
    "change_history": { "type": "array", "items": { "$ref": "#/$defs/change" } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["value", "epistemic_status", "evidence_ids"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "unevaluatedProperties": false
    },
    "step": {
      "type": "object",
      "required": ["step_id", "instruction", "epistemic_status", "evidence_ids"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "location": { "anyOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
        "platform": { "anyOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
        "required_materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "unevaluatedProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["dependency_id", "from_step_id", "to_step_id", "type"],
      "properties": {
        "dependency_id": { "type": "string", "minLength": 1 },
        "from_step_id": { "type": "string", "minLength": 1 },
        "to_step_id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["blocks", "requires", "informs", "alternative_to", "postpones", "revokes", "replaces"] },
        "condition_id": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["condition_id", "statement", "outcomes", "epistemic_status", "evidence_ids"],
      "properties": {
        "condition_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["label", "step_ids"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "step_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "unevaluatedProperties": false
          }
        },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "unevaluatedProperties": false
    },
    "exception": {
      "type": "object",
      "required": ["exception_id", "statement", "epistemic_status", "evidence_ids"],
      "properties": {
        "exception_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "unevaluatedProperties": false
    },
    "deadline": {
      "type": "object",
      "required": ["value", "precision", "boundary_semantics", "epistemic_status", "evidence_ids"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?(?:/[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2})?(?:Z|[+-][0-9]{2}:[0-9]{2})?)?)?)?$"
        },
        "precision": { "enum": ["minute", "hour", "day", "range", "unknown"] },
        "boundary_semantics": { "enum": ["before", "no_later_than", "on", "after", "unknown"] },
        "timezone": { "type": "string", "minLength": 1 },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "unevaluatedProperties": false
    },
    "material": {
      "type": "object",
      "required": ["material_id", "description", "epistemic_status", "evidence_ids"],
      "properties": {
        "material_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "unevaluatedProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "source_text", "page_or_image", "field_name", "epistemic_status"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_text": { "type": "string", "minLength": 1 },
        "page_or_image": { "type": "string", "minLength": 1 },
        "bounding_box": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "field_name": { "enum": ["user_relevance", "target_population", "steps", "dependencies", "conditions", "exceptions", "deadline", "location", "platform", "entry_link", "required_materials", "consequence"] },
        "epistemic_status": { "$ref": "#/$defs/epistemicStatus" }
      },
      "unevaluatedProperties": false
    },
    "confidence": {
      "type": "object", "required": ["score", "basis"],
      "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "basis": { "enum": ["model", "rule_review", "user_confirmed"] } },
      "unevaluatedProperties": false
    },
    "fieldStatus": {
      "type": "object",
      "required": ["user_relevance", "target_population", "steps", "deadline", "required_materials", "location", "platform", "conditions", "exceptions"],
      "properties": {
        "user_relevance": { "$ref": "#/$defs/epistemicStatus" },
        "target_population": { "$ref": "#/$defs/epistemicStatus" },
        "steps": { "$ref": "#/$defs/epistemicStatus" },
        "deadline": { "$ref": "#/$defs/epistemicStatus" },
        "required_materials": { "$ref": "#/$defs/epistemicStatus" },
        "location": { "$ref": "#/$defs/epistemicStatus" },
        "platform": { "$ref": "#/$defs/epistemicStatus" },
        "conditions": { "$ref": "#/$defs/epistemicStatus" },
        "exceptions": { "$ref": "#/$defs/epistemicStatus" }
      },
      "unevaluatedProperties": false
    },
    "epistemicStatus": { "enum": ["explicit", "rule_inferred", "ai_estimated", "unknown"] },
    "resultStage": { "enum": ["model_output", "rule_reviewed", "user_confirmed"] },
    "change": {
      "type": "object", "required": ["change_id", "occurred_at", "actor", "change_type", "reason"],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "actor": { "enum": ["model", "rule_engine", "publisher", "user", "system"] },
        "change_type": { "enum": ["created", "reviewed", "confirmed", "postponed", "revoked", "replaced", "corrected"] },
        "reason": { "type": "string", "minLength": 1 },
        "previous_action_id": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    }
  }
}
